name: CD

on:
  push:
    branches: [dev]
  workflow_dispatch:
    inputs:
      version:
        description: "Manual release version"
        required: false
        type: string

permissions:
  contents: write
  id-token: write

env:
  AWS_REGION: ap-northeast-2
  AWS_ACCOUNT_ID: "719905537984"
  ECR_REPOSITORY: community-board-fe
  APP_NAME: community-board-fe
  APP_PORT: "3000"
  HEALTH_CHECK_PATH: /

  LAUNCH_TEMPLATE_ID: ${{ vars.LAUNCH_TEMPLATE_ID }}
  VPC_ID: ${{ vars.VPC_ID }}
  SUBNET_IDS: ${{ vars.SUBNET_IDS }}
  ALB_LISTENER_ARN: ${{ vars.ALB_LISTENER_ARN }}

jobs:
  tag-image:
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.version.outputs.version }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Calculate semver
        id: version
        env:
          MANUAL_VERSION: ${{ inputs.version }}
        run: |
          set -euo pipefail

          # workflow_dispatch로 버전을 직접 입력한 경우 그 값을 그대로 사용
          if [ "${GITHUB_EVENT_NAME}" = "workflow_dispatch" ] && [ -n "${MANUAL_VERSION}" ]; then
            if ! printf '%s\n' "${MANUAL_VERSION}" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
              echo "Manual version must be vMAJOR.MINOR.PATCH, for example v1.2.1." >&2
              exit 1
            fi
            echo "version=${MANUAL_VERSION}" >> "${GITHUB_OUTPUT}"
            echo "Using manual version: ${MANUAL_VERSION}"
            exit 0
          fi

          LATEST_TAG="$(git describe --tags --abbrev=0 2>/dev/null || true)"
          if [ -z "${LATEST_TAG}" ]; then
            BASE_VERSION="v0.0.0"
            RANGE=""
          else
            BASE_VERSION="${LATEST_TAG}"
            RANGE="${LATEST_TAG}..HEAD"
          fi

          if [ -n "${RANGE}" ]; then
            COMMITS="$(git log "${RANGE}" --pretty=format:%s)"
          else
            COMMITS="$(git log --pretty=format:%s)"
          fi

          if ! printf '%s\n' "${COMMITS}" | grep -q '^feat:'; then
            echo "No feat: commit found after ${BASE_VERSION}. Deployment will be skipped."
            echo "version=" >> "${GITHUB_OUTPUT}"
            exit 0
          fi

          RAW_VERSION="${BASE_VERSION#v}"
          MAJOR="$(printf '%s' "${RAW_VERSION}" | cut -d. -f1)"
          MINOR="$(printf '%s' "${RAW_VERSION}" | cut -d. -f2)"

          NEXT_MINOR="$((MINOR + 1))"
          NEXT_VERSION="v${MAJOR}.${NEXT_MINOR}.0"
          echo "version=${NEXT_VERSION}" >> "${GITHUB_OUTPUT}"
          echo "Calculated version: ${NEXT_VERSION}"

      - name: Configure AWS credentials
        if: steps.version.outputs.version != ''
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        if: steps.version.outputs.version != ''
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push SHA image
        if: steps.version.outputs.version != ''
        run: |
          set -euo pipefail

          SHORT_SHA="${GITHUB_SHA::7}"
          ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
          IMAGE_URI="${ECR_REGISTRY}/${ECR_REPOSITORY}"

          if aws ecr describe-images \
            --repository-name "${ECR_REPOSITORY}" \
            --image-ids imageTag="${SHORT_SHA}" \
            >/dev/null 2>&1; then
            echo "Image tag ${SHORT_SHA} already exists. Skipping SHA image push."
            exit 0
          fi

          docker build -t "${ECR_REPOSITORY}:${SHORT_SHA}" .
          docker tag "${ECR_REPOSITORY}:${SHORT_SHA}" "${IMAGE_URI}:${SHORT_SHA}"
          docker push "${IMAGE_URI}:${SHORT_SHA}"

      - name: Promote SHA image to semver tag
        if: steps.version.outputs.version != ''
        run: |
          set -euo pipefail

          SHORT_SHA="${GITHUB_SHA::7}"
          VERSION="${{ steps.version.outputs.version }}"
          ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
          IMAGE_URI="${ECR_REGISTRY}/${ECR_REPOSITORY}"

          if aws ecr describe-images \
            --repository-name "${ECR_REPOSITORY}" \
            --image-ids imageTag="${VERSION}" \
            >/dev/null 2>&1; then
            echo "Image tag ${VERSION} already exists. Skipping retag."
            exit 0
          fi

          docker pull "${IMAGE_URI}:${SHORT_SHA}"
          docker tag "${IMAGE_URI}:${SHORT_SHA}" "${IMAGE_URI}:${VERSION}"
          docker push "${IMAGE_URI}:${VERSION}"

  deploy:
    runs-on: ubuntu-latest
    needs: tag-image
    if: needs.tag-image.outputs.version != ''

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Validate required configuration
        run: |
          set -euo pipefail

          for required in LAUNCH_TEMPLATE_ID VPC_ID SUBNET_IDS ALB_LISTENER_ARN; do
            value="${!required}"
            if [ -z "${value}" ] || printf '%s' "${value}" | grep -q '^TODO_'; then
              echo "${required} must be set before deployment." >&2
              exit 1
            fi
          done

      - name: Deploy green ASG and switch ALB
        run: |
          set -euo pipefail

          VERSION="${{ needs.tag-image.outputs.version }}"
          ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
          IMAGE_URI="${ECR_REGISTRY}/${ECR_REPOSITORY}:${VERSION}"
          GREEN_SUFFIX="$(date +%Y%m%d%H%M%S)"
          GREEN_ASG_NAME="${APP_NAME}-green-${GREEN_SUFFIX}"
          GREEN_TG_NAME="cb-fe-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          HEALTH_CHECK_TIMEOUT_SECONDS=600
          HEALTH_CHECK_INTERVAL_SECONDS=15
          BAKE_TIME_SECONDS=300
          GREEN_TG_ARN=""

          BLUE_TG_ARN="$(aws elbv2 describe-listeners \
            --listener-arns "${ALB_LISTENER_ARN}" \
            --query 'Listeners[0].DefaultActions[0].TargetGroupArn' \
            --output text)"

          BLUE_ASG_NAME="$(aws autoscaling describe-auto-scaling-groups \
            --query "AutoScalingGroups[?contains(TargetGroupARNs, '${BLUE_TG_ARN}')].AutoScalingGroupName | [0]" \
            --output text)"

          if [ -z "${BLUE_ASG_NAME}" ] || [ "${BLUE_ASG_NAME}" = "None" ]; then
            echo "Could not find the current blue ASG attached to ${BLUE_TG_ARN}." >&2
            exit 1
          fi

          BLUE_DESIRED_CAPACITY="$(aws autoscaling describe-auto-scaling-groups \
            --auto-scaling-group-names "${BLUE_ASG_NAME}" \
            --query 'AutoScalingGroups[0].DesiredCapacity' \
            --output text)"
          BLUE_MIN_SIZE="$(aws autoscaling describe-auto-scaling-groups \
            --auto-scaling-group-names "${BLUE_ASG_NAME}" \
            --query 'AutoScalingGroups[0].MinSize' \
            --output text)"
          BLUE_MAX_SIZE="$(aws autoscaling describe-auto-scaling-groups \
            --auto-scaling-group-names "${BLUE_ASG_NAME}" \
            --query 'AutoScalingGroups[0].MaxSize' \
            --output text)"

          cleanup_green() {
            set +e
            aws autoscaling update-auto-scaling-group \
              --auto-scaling-group-name "${GREEN_ASG_NAME}" \
              --min-size 0 \
              --desired-capacity 0 >/dev/null 2>&1
            aws autoscaling delete-auto-scaling-group \
              --auto-scaling-group-name "${GREEN_ASG_NAME}" \
              --force-delete >/dev/null 2>&1
            if [ -n "${GREEN_TG_ARN:-}" ]; then
              aws elbv2 delete-target-group --target-group-arn "${GREEN_TG_ARN}" >/dev/null 2>&1
            fi
          }

          rollback() {
            set +e
            if [ -n "${BLUE_TG_ARN:-}" ] && [ "${BLUE_TG_ARN}" != "None" ]; then
              aws elbv2 modify-listener \
                --listener-arn "${ALB_LISTENER_ARN}" \
                --default-actions "Type=forward,TargetGroupArn=${BLUE_TG_ARN}" >/dev/null 2>&1
            fi
            cleanup_green
            exit 1
          }

          trap 'rollback' ERR

          # EC2 User Data: Ubuntu 기준으로 Docker와 AWS CLI v2를 설치한 뒤 컨테이너를 실행합니다.
          cat > user-data.sh <<EOF
          #!/bin/bash
          set -euxo pipefail

          apt-get update -y
          apt-get install -y docker.io docker-compose-v2 curl unzip
          systemctl enable --now docker

          ARCH="\$(uname -m)"
          case "\${ARCH}" in
            x86_64)
              AWS_CLI_ZIP_URL="https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip"
              ;;
            aarch64|arm64)
              AWS_CLI_ZIP_URL="https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip"
              ;;
            *)
              echo "Unsupported architecture: \${ARCH}" >&2
              exit 1
              ;;
          esac

          curl "\${AWS_CLI_ZIP_URL}" -o /tmp/awscliv2.zip
          unzip -q /tmp/awscliv2.zip -d /tmp
          /tmp/aws/install --bin-dir /usr/local/bin --install-dir /usr/local/aws-cli --update

          mkdir -p /opt/${APP_NAME}
          cat > /opt/${APP_NAME}/docker-compose.yml <<'COMPOSE'
          services:
            app:
              image: ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:\${IMAGE_TAG}
              container_name: community-board-fe
              restart: unless-stopped
              ports:
                - "80:3000"
              environment:
                NODE_ENV: production
                API_BASE_URL: "https://community-board.p-e.kr"
              mem_limit: 256m
              cpus: 0.5
          COMPOSE

          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
          export IMAGE_TAG=${VERSION}
          docker compose -f /opt/${APP_NAME}/docker-compose.yml pull
          docker compose -f /opt/${APP_NAME}/docker-compose.yml up -d
          EOF

          USER_DATA_B64="$(base64 -w 0 user-data.sh)"

          LT_VERSION="$(aws ec2 create-launch-template-version \
            --launch-template-id "${LAUNCH_TEMPLATE_ID}" \
            --source-version '$Latest' \
            --version-description "${APP_NAME}-${VERSION}" \
            --launch-template-data "{\"UserData\":\"${USER_DATA_B64}\"}" \
            --query 'LaunchTemplateVersion.VersionNumber' \
            --output text)"

          GREEN_TG_ARN="$(aws elbv2 create-target-group \
            --name "${GREEN_TG_NAME}" \
            --protocol HTTP \
            --port 80 \
            --vpc-id "${VPC_ID}" \
            --target-type instance \
            --health-check-protocol HTTP \
            --health-check-path "${HEALTH_CHECK_PATH}" \
            --matcher '{"HttpCode":"200,302"}' \
            --query 'TargetGroups[0].TargetGroupArn' \
            --output text)"

          aws autoscaling create-auto-scaling-group \
            --auto-scaling-group-name "${GREEN_ASG_NAME}" \
            --launch-template "LaunchTemplateId=${LAUNCH_TEMPLATE_ID},Version=${LT_VERSION}" \
            --min-size "${BLUE_MIN_SIZE}" \
            --max-size "${BLUE_MAX_SIZE}" \
            --desired-capacity "${BLUE_DESIRED_CAPACITY}" \
            --vpc-zone-identifier "${SUBNET_IDS}" \
            --health-check-type ELB \
            --health-check-grace-period 300 \
            --target-group-arns "${GREEN_TG_ARN}" \
            --tags "Key=Name,Value=${GREEN_ASG_NAME},PropagateAtLaunch=true"

          # 인스턴스가 부팅을 시작할 시간 대기
          sleep 15

          aws elbv2 modify-listener \
            --listener-arn "${ALB_LISTENER_ARN}" \
            --default-actions "Type=forward,TargetGroupArn=${GREEN_TG_ARN}"

          echo "Waiting for green targets to become healthy..."
          DEADLINE=$((SECONDS + HEALTH_CHECK_TIMEOUT_SECONDS))
          HEALTHY_COUNT=0
          while [ "${SECONDS}" -lt "${DEADLINE}" ]; do
            HEALTHY_COUNT="$(aws elbv2 describe-target-health \
              --target-group-arn "${GREEN_TG_ARN}" \
              --query "length(TargetHealthDescriptions[?TargetHealth.State=='healthy'])" \
              --output text)"

            if [ "${HEALTHY_COUNT}" -ge "${BLUE_DESIRED_CAPACITY}" ] && [ "${BLUE_DESIRED_CAPACITY}" -gt 0 ]; then
              echo "Green target group is healthy."
              break
            fi

            echo "Waiting for green targets: ${HEALTHY_COUNT}/${BLUE_DESIRED_CAPACITY} healthy."
            sleep "${HEALTH_CHECK_INTERVAL_SECONDS}"
          done

          if [ "${HEALTHY_COUNT}" -lt "${BLUE_DESIRED_CAPACITY}" ] || [ "${BLUE_DESIRED_CAPACITY}" -eq 0 ]; then
            echo "Green target group did not become healthy before timeout." >&2
            exit 1
          fi

          sleep "${BAKE_TIME_SECONDS}"

          trap - ERR

          aws autoscaling update-auto-scaling-group \
            --auto-scaling-group-name "${BLUE_ASG_NAME}" \
            --min-size 0 \
            --desired-capacity 0
          aws autoscaling delete-auto-scaling-group \
            --auto-scaling-group-name "${BLUE_ASG_NAME}" \
            --force-delete

          if [ -n "${BLUE_TG_ARN}" ] && [ "${BLUE_TG_ARN}" != "None" ]; then
            aws elbv2 delete-target-group --target-group-arn "${BLUE_TG_ARN}"
          fi

          echo "Deployment completed with ${GREEN_ASG_NAME} and ${GREEN_TG_NAME}."

      - name: Create Git version tag
        run: |
          set -euo pipefail

          VERSION="${{ needs.tag-image.outputs.version }}"
          if git rev-parse "${VERSION}" >/dev/null 2>&1; then
            echo "Git tag ${VERSION} already exists. Skipping tag creation."
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git tag "${VERSION}" "${GITHUB_SHA}"
          git push origin "${VERSION}"